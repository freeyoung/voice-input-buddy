#!/bin/bash
set -euo pipefail
source "$(dirname "$0")/installation-common.sh"

# Only the App belongs to the desktop user. HAL drivers remain system-owned.
# An offline volume or login window has no local desktop owner to use.
if [[ "${3:-/}" == / ]]; then
    app='/Applications/Voice Input Buddy.app'
    buddy_check_bundle "$app" com.zfdang.voice-input-buddy
    if [[ -d "$app" ]]; then
        owner_uid="$(/usr/bin/stat -f '%u' /dev/console)"
        if [[ "$owner_uid" =~ ^[0-9]+$ && "$owner_uid" -ge 501 ]]; then
            owner_gid="$(/usr/bin/id -g "$owner_uid")"
            [[ "$owner_gid" =~ ^[0-9]+$ ]] || exit 1
            # Do not follow bundle symlinks into paths outside the installed App.
            /usr/sbin/chown -R -P -h "$owner_uid:$owner_gid" "$app"
            echo 'App ownership assigned to the logged-in desktop user.'
        else
            echo 'No desktop user; leaving system App ownership unchanged.'
        fi
    fi
fi

# Keep driver fingerprinting and conditional Core Audio restart in one place.
exec /bin/bash "$(dirname "$0")/driver-postinstall" "$@"
