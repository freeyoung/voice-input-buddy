#!/bin/bash
set -euo pipefail
source "$(dirname "$0")/installation-common.sh"
# A same-UID plug-in must not remain in HAL under the previous filename.
volume="${3:-/}"
buddy_check_bundle "${volume%/}/Library/Audio/Plug-Ins/HAL/VoiceInputBuddyMic.driver" com.zfdang.voice-input-buddy.mic
buddy_remove_bundle "${volume%/}/Library/Audio/Plug-Ins/HAL/BuddyMic2ch.driver" com.zfdang.voice-input-buddy.mic
